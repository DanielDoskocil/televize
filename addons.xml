<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="script.arnost.homelayout" name="Rozvržení domovské obrazovky" version="1.0.2" provider-name="Arnošt">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.skinvariables" version="2.3.12"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <reuselanguageinvoker>false</reuselanguageinvoker>
        <summary lang="cs_CZ">Nastaví řady na domovské obrazovce.</summary>
        <summary lang="en_GB">Applies a home screen row layout.</summary>
        <description lang="cs_CZ">Doplněk nastaví řady a úvodní banner (spotlight) na domovské obrazovce aktuálního vzhledu. Před změnou vytvoří zálohu, kterou lze později obnovit.</description>
        <description lang="en_GB">Applies home screen rows and the spotlight banner for the current skin. A backup is created first and can be restored later.</description>
        <news lang="cs_CZ">1.0.2: Úvodní banner je Populární. Řady: Populární, Pokračovat ve sledování, Novinky – filmy, Novinky – seriály, Dabované, Pro děti (bez Tip na večer).</news>
        <news lang="en_GB">1.0.2: Spotlight is Popular. Rows: Popular, Continue watching, New movies, New series, Dubbed, For kids (For you removed).</news>
        <platform>all</platform>
        <license>MIT</license>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
<addon id="repository.televize" name="Televize" version="1.0.0" provider-name="Arnošt">
    <extension point="xbmc.addon.repository" name="Televize">
        <dir>
            <info compressed="false">https://danieldoskocil.github.io/televize/addons.xml</info>
            <checksum>https://danieldoskocil.github.io/televize/addons.xml.md5</checksum>
            <datadir zip="true">https://danieldoskocil.github.io/televize/zips</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="cs_CZ">Drobnosti k televizi.</summary>
        <summary lang="en_GB">Small bits for the TV.</summary>
        <description lang="cs_CZ">Jednoduché úložiště drobností k televizi.</description>
        <description lang="en_GB">A simple store of small bits for the TV.</description>
        <platform>all</platform>
        <license>MIT</license>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
</addons>
