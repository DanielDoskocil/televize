# Rozvržení domovské obrazovky
msgid ""
msgstr ""
"Language: cs_CZ\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgctxt "#32000"
msgid "Home layout"
msgstr "Rozvržení"

msgctxt "#32001"
msgid "Apply layout"
msgstr "Použít rozvržení"

msgctxt "#32002"
msgid "Restore backup"
msgstr "Obnovit zálohu"

msgctxt "#32003"
msgid "Cancel"
msgstr "Zrušit"

msgctxt "#32010"
msgid "Please switch to the Arctic Fuse 3 skin first."
msgstr "Nejdřív zapněte vzhled Arctic Fuse 3."

msgctxt "#32011"
msgid "Skin Variables is not installed, so the skin cannot save the rows."
msgstr "Chybí doplněk Skin Variables, bez něj vzhled neumí uložit řady."

msgctxt "#32012"
msgid "The video add-on these rows use is not installed. The rows may stay empty. Continue anyway?"
msgstr "Video doplněk, ze kterého řady čerpají, není nainstalovaný. Řady mohou zůstat prázdné. Přesto pokračovat?"

msgctxt "#32020"
msgid "This will replace the current home screen rows and set the spotlight banner to Popular. A backup will be created first. Continue?"
msgstr "Nahradí aktuální řady na domovské obrazovce a nastaví velký úvodní banner na Populární. Nejdřív se vytvoří záloha. Pokračovat?"

msgctxt "#32021"
msgid "The backup or write failed: {0}"
msgstr "Záloha nebo zápis se nepovedly: {0}"

msgctxt "#32022"
msgid "The layout is applied. Backup: {0}. The screen will reload in a moment."
msgstr "Rozvržení je nastavené. Záloha: {0}. Obrazovka se za chvíli znovu načte."

msgctxt "#32023"
msgid "The layout is applied. The screen will reload in a moment."
msgstr "Rozvržení je nastavené. Obrazovka se za chvíli znovu načte."

msgctxt "#32030"
msgid "There is no backup yet."
msgstr "Žádná záloha zatím není."

msgctxt "#32031"
msgid "Select a backup"
msgstr "Vyberte zálohu"

msgctxt "#32032"
msgid "Restore backup {0}? The current rows will be overwritten."
msgstr "Obnovit zálohu {0}? Aktuální řady se přepíšou."

msgctxt "#32033"
msgid "Restore failed: {0}"
msgstr "Obnova se nepovedla: {0}"

msgctxt "#32034"
msgid "The backup has been restored. The screen will reload in a moment."
msgstr "Záloha je obnovená. Obrazovka se za chvíli znovu načte."
